# MongoDB Atlas connection string. Creates/uses a database named "mambosamagakkou".
MONGODB_URI=

# Random secret used to sign the admin session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Single administrator's login username.
ADMIN_USERNAME=

# bcrypt hash of the administrator's password. Generate after `npm install` with:
#   node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Vercel Blob read/write token. Create a Blob store in the Vercel dashboard and
# link it to this project — Vercel injects this automatically in deployments.
# For local development, copy the value from the dashboard into .env.local.
BLOB_READ_WRITE_TOKEN=
